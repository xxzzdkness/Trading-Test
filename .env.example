# Telegram bot settings (required for notifications)
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_CHAT_ID=123456789

# Optional news provider. If omitted, news is skipped gracefully.
# Get a key from https://newsapi.org/ or adapt the provider in monitor.py.
NEWSAPI_KEY=

# Optional runtime tuning
WATCHLIST_FILE=watchlist.yaml
JOURNAL_FILE=journal.csv
DATA_INTERVAL=5m
LOOKBACK_PERIOD=5d
RUN_EVERY_MINUTES=30
